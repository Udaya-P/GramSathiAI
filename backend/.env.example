DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/gramsathi
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=REPLACE_WITH_A_RANDOM_GENERATED_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
# JSON array of exact frontend origins, without trailing slashes; [] disables CORS.
CORS_ORIGINS=[]
# Dedicated database, distinct from DATABASE_URL. Tests create/drop only a random schema.
TEST_DATABASE_URL=postgresql+psycopg://TEST_USERNAME:TEST_PASSWORD@HOST:5432/gramsathi_test
# Official Gnani Prisma Batch API key; backend only. Optional until worker is enabled.
GNANI_API_KEY=

# Server-side reasoning configuration. Use a model available to your Groq account.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Private API-host storage for original M4A recordings. Default: backend/.recordings.
# AUDIO_STORAGE_DIR=/path/to/private/persistent/recordings
